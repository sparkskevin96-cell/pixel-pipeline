{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "{{checkpoint}}"
    },
    "_meta": {
      "title": "Load checkpoint"
    }
  },
  "2": {
    "class_type": "LoraLoader",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "clip": [
        "1",
        1
      ],
      "lora_name": "{{lora}}",
      "strength_model": "{{lora_strength}}",
      "strength_clip": "{{lora_strength}}"
    },
    "_meta": {
      "title": "Pixel art LoRA"
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{prompt}}",
      "clip": [
        "2",
        1
      ]
    },
    "_meta": {
      "title": "Prompt"
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{negative}}",
      "clip": [
        "2",
        1
      ]
    },
    "_meta": {
      "title": "Negative prompt"
    }
  },
  "8": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{image}}"
    },
    "_meta": {
      "title": "Init image"
    }
  },
  "9": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": [
        "8",
        0
      ],
      "vae": [
        "1",
        2
      ]
    },
    "_meta": {
      "title": "Encode init image"
    }
  },
  "10": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "2",
        0
      ],
      "seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": "{{cfg}}",
      "sampler_name": "{{sampler}}",
      "scheduler": "{{scheduler}}",
      "positive": [
        "6",
        0
      ],
      "negative": [
        "7",
        0
      ],
      "latent_image": [
        "9",
        0
      ],
      "denoise": "{{denoise}}"
    },
    "_meta": {
      "title": "Sampler"
    }
  },
  "11": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "10",
        0
      ],
      "vae": [
        "1",
        2
      ]
    },
    "_meta": {
      "title": "Decode"
    }
  },
  "12": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "11",
        0
      ],
      "filename_prefix": "{{prefix}}"
    },
    "_meta": {
      "title": "Save"
    }
  }
}
